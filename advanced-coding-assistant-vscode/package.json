{
  "name": "advanced-coding-assistant",
  "displayName": "Advanced Coding Assistant",
  "description": "An advanced coding assistant for VS Code",
  "version": "0.0.1",
  "publisher": "bitsInnovate00",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitsInnovate00/advanced-coding-assistant-backend.git",
    "directory": "advanced-coding-assistant-vscode"
  },
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "advanced-coding-assistant.helloWorld",
        "title": "Advanced Coding Assistant: Hello World"
      },
      {
        "command": "advanced-coding-assistant.showStatus",
        "title": "Advanced Coding Assistant: Show Status"
      }
    ],
    "configuration": {
      "title": "Advanced Coding Assistant",
      "properties": {
        "advancedCodingAssistant.apiEndpoint": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "The API endpoint URL for the Advanced Coding Assistant backend"
        },
        "advancedCodingAssistant.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry to help improve the extension"
        },
        "advancedCodingAssistant.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "The logging level for the output channel"
        },
        "advancedCodingAssistant.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to the backend on extension activation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
